[Unit]
Description=Prune expired whyslow incident data
Documentation=https://github.com/kraftaa/whyslow

[Service]
Type=oneshot
User=whyslow
Group=whyslow
ExecStart=/opt/whyslow/venv/bin/whyslow prune --db /var/lib/whyslow/store.sqlite3

StateDirectory=whyslow
StateDirectoryMode=0700
UMask=0077
MemoryMax=512M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/whyslow
